{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "_base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "PVPGN_V3": "ON",
                "PVPGN_V3_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "v3-dev",
            "inherits": "_base",
            "displayName": "V3 Development (Debug + tests)",
            "binaryDir": "${sourceDir}/build/v3-dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_UNIT_TESTS": "ON"
            }
        },
        {
            "name": "v3-release",
            "inherits": "_base",
            "displayName": "V3 Release (LTO + warnings-as-errors)",
            "binaryDir": "${sourceDir}/build/v3-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PVPGN_V3": "ON",
                "PVPGN_V3_WARNINGS_AS_ERRORS": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
            }
        },
        {
            "name": "v3-asan",
            "displayName": "V3 AddressSanitizer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/v3-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_UNIT_TESTS": "ON",
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer"
            }
        },
        {
            "name": "v3-ubsan",
            "displayName": "V3 UndefinedBehaviorSanitizer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/v3-ubsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_UNIT_TESTS": "ON",
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer"
            }
        },
        {
            "name": "v3-tsan",
            "displayName": "V3 ThreadSanitizer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/v3-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_UNIT_TESTS": "ON",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread"
            }
        },
        {
            "name": "v3-coverage",
            "displayName": "V3 Coverage (gcov)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/v3-coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_UNIT_TESTS": "ON",
                "CMAKE_CXX_FLAGS": "--coverage",
                "CMAKE_EXE_LINKER_FLAGS": "--coverage"
            }
        },
        {
            "name": "v3-fuzz",
            "displayName": "V3 Fuzzing (libFuzzer)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/v3-fuzz",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PVPGN_V3": "ON",
                "PVPGN_V3_FUZZ_TESTS": "ON",
                "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer,address"
            }
        }
    ],
    "buildPresets": [
        { "name": "v3-dev",      "configurePreset": "v3-dev" },
        { "name": "v3-release",  "configurePreset": "v3-release" },
        { "name": "v3-asan",     "configurePreset": "v3-asan" },
        { "name": "v3-ubsan",    "configurePreset": "v3-ubsan" },
        { "name": "v3-tsan",     "configurePreset": "v3-tsan" },
        { "name": "v3-coverage", "configurePreset": "v3-coverage" },
        { "name": "v3-fuzz",     "configurePreset": "v3-fuzz" }
    ],
    "testPresets": [
        {
            "name": "v3-dev",
            "configurePreset": "v3-dev",
            "output": { "outputOnFailure": true },
            "execution": { "stopOnFailure": false, "jobs": 4 }
        },
        {
            "name": "v3-release",
            "configurePreset": "v3-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "v3-asan",
            "configurePreset": "v3-asan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "v3-tsan",
            "configurePreset": "v3-tsan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "v3-coverage",
            "configurePreset": "v3-coverage",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "v3-fuzz",
            "configurePreset": "v3-fuzz",
            "output": { "outputOnFailure": true }
        }
    ]
}
