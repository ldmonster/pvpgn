 && /src/build/v3/tests/unit/infra/legacy_crypto/test_common_bigint --reporter compact \
 && /src/build/v3/tests/unit/infra/legacy_crypto/test_common_bnetsrp3 --reporter compact \
 && /src/build/v3/tests/unit/protocol/bnet/test_protocol_bnet_codec --reporter compact

# -----------------------------------------------------------------------------
# Stage: v3-e2e
# Runs end-to-end smoke tests against Python mock servers that mimic
# the legacy bnetd surface.  Each smoke step builds a parameterized
# wire mock, drives one v3 client binary against it, and asserts
# something observable end-to-end (downloaded bytes for bnftp,
# rendered chat line for bnchat).  Real bnetd is intentionally not
# spun up here -- it would require full config / DB scaffolding.
# -----------------------------------------------------------------------------
FROM v3-test AS v3-e2e

RUN apk --quiet --no-cache add python3

RUN chmod +x /src/scripts/v3-e2e-bnftp-smoke.sh \
             /src/scripts/v3-e2e-bnchat-smoke.sh \
             /src/scripts/v3-e2e-bnstat-smoke.sh \
             /src/scripts/v3-e2e-bnbot-smoke.sh \
             /src/tests/e2e/fake_bnftp_server.py \
             /src/tests/e2e/fake_bnet_server.py \
             /src/tests/e2e/fake_bnbot_server.py \
 && /src/scripts/v3-e2e-bnftp-smoke.sh  /src/build/v3/src/v3/tools/client/bnftp  \
 && /src/scripts/v3-e2e-bnchat-smoke.sh /src/build/v3/src/v3/tools/client/bnchat \
 && /src/scripts/v3-e2e-bnstat-smoke.sh /src/build/v3/src/v3/tools/client/bnstat \
 && /src/scripts/v3-e2e-bnbot-smoke.sh  /src/build/v3/src/v3/tools/client/bnbot
