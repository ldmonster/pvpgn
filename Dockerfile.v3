 && /src/build/v3/tests/unit/integration/legacy_bnetd/test_integration_legacy_bnetd_cdkey_dispatch_bridge --reporter compact \
 && /src/build/v3/tests/unit/integration/legacy_bnetd/test_integration_legacy_bnetd_passemail_dispatch_bridge --reporter compact \
 && /src/build/v3/tests/unit/integration/legacy_bnetd/test_integration_legacy_bnetd_handshake_dispatch_bridge --reporter compact \
