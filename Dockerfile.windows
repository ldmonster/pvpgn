# =============================================================================
# Dockerfile.windows
#
# Cross-compiles PvPGN executables to 64-bit Windows .exe binaries from a
# Linux build host using MinGW-w64 + vcpkg (x64-mingw-static triplet).
#
# The build stage configures the full v3 tree with tests disabled, builds the
# project, then installs into a clean prefix. The export stage contains the
# installed Windows executables plus a manifest, ready for:
#
#   docker buildx build -f Dockerfile.windows \
#       --output type=local,dest=./dist/windows .
#
# Produced executables currently include the Windows-capable targets that exist
# in this repo today, such as:
#   - bnetd.exe
#   - pvpgn_v3_d2cs.exe
#   - pvpgn_config_tool.exe
#   - pvpgn_migrate.exe
#   - pvpgn-conf-convert.exe
#   - pvpgn-bnpass.exe
#   - bnchat.exe / bnftp.exe / bnbot.exe / bnstat.exe
#   - bntrackd.exe
#   - bnilist.exe / bni2tga.exe / bniextract.exe / bnibuild.exe / tgainfo.exe
#
# There is no standalone D2DBS executable target in the current tree, so this
# Dockerfile exports the executable set that CMake actually defines today.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: toolchain
# Debian base + MinGW-w64 cross-toolchain + CMake/Ninja + vcpkg prerequisites.
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS toolchain

ENV DEBIAN_FRONTEND=noninteractive
ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DOWNLOADS=/opt/vcpkg-downloads \
    VCPKG_DEFAULT_TRIPLET=x64-mingw-static \
    VCPKG_DEFAULT_HOST_TRIPLET=x64-linux \
    VCPKG_FORCE_SYSTEM_BINARIES=1 \
    VCPKG_DISABLE_METRICS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        curl \
        zip \
        unzip \
        tar \
        pkg-config \
        build-essential \
        cmake \
        ninja-build \
        python3 \
        bison \
        flex \
        autoconf \
        autoconf-archive \
        automake \
        libtool \
        nasm \
        mingw-w64 \
        mingw-w64-tools \
    && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix \
    && rm -rf /var/lib/apt/lists/*

# Debian bookworm ships CMake 3.25, whose bundled FindBoost predates modern
# Boost (1.91) and mishandles the vcpkg modular BoostConfig graph for the
# cross-triplet. Install a current CMake from the official Kitware binary so
# `cmake` on PATH (/usr/local/bin) shadows the apt one for the vcpkg build.
ARG CMAKE_VERSION=3.31.6
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
        | tar xz -C /opt \
    && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake" /usr/local/bin/cmake \
    && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest" /usr/local/bin/ctest \
    && cmake --version


# -----------------------------------------------------------------------------
# Stage: vcpkg
# Bootstrap vcpkg from a configurable ref.
#
# The repo's current builtin-baseline is stale for the declared dependency
# set, so the build stage rewrites the copied manifest baseline to the vcpkg
# checkout commit before running CMake. This keeps the host repo untouched
# while making manifest-mode resolution work inside the image.
# -----------------------------------------------------------------------------
FROM toolchain AS vcpkg

# Pin to a tagged vcpkg release rather than `master` for reproducible builds.
# NOTE: this does NOT by itself fix the known x64-mingw-static cross-configure
# failure where vcpkg's modular BoostConfig.cmake find_package()s a
# `boost_headers` package the cross-triplet wrapper cannot resolve — that
# reproduces on both master and tagged releases (Boost 1.91) and needs a
# dedicated vcpkg fix (overlay port / older pinned Boost / non-vcpkg Boost).
# See docs/refactoring/progress.md.
ARG VCPKG_REF=2026.05.25

RUN mkdir -p ${VCPKG_DOWNLOADS} \
    && git clone --branch ${VCPKG_REF} https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} \
    && ${VCPKG_ROOT}/bootstrap-vcpkg.sh -disableMetrics


# -----------------------------------------------------------------------------
# Stage: src
# Copy project source after the heavy toolchain layers so source edits don't
# bust the toolchain/vcpkg layer caches.
# -----------------------------------------------------------------------------
FROM vcpkg AS src

COPY . /src
WORKDIR /src


# -----------------------------------------------------------------------------
# Stage: build
# Configure + build the Windows-capable executable set, then install it.
#
# Notes:
#   * PVPGN_BUILD_V3=ON / PVPGN_BUILD_LEGACY=OFF — build the modern tree only
#   * VCPKG_MANIFEST_FEATURES=sqlite — needed for pvpgn_migrate and sqlite-backed
#       runtime support under Windows
#   * BUILD_TESTING=OFF / PVPGN_V3_BUILD_TESTS=OFF — ship binaries only
#   * PVPGN_V3_WARNINGS_AS_ERRORS=OFF — keep MinGW-specific warnings non-fatal
# -----------------------------------------------------------------------------
FROM src AS build

ARG JOBS=4
ARG CMAKE_BUILD_TYPE=Release
ARG VCPKG_MANIFEST_FEATURES=sqlite
ARG INSTALL_PREFIX=/opt/pvpgn-windows
ARG CONFIGURE_RETRIES=3

ENV VCPKG_MANIFEST_FEATURES=${VCPKG_MANIFEST_FEATURES}

# Cache mounts persist vcpkg's binary cache + downloads across builds, so a
# re-run (or a configure-retry that wipes build/windows) restores the prebuilt
# mingw dependencies instead of recompiling Boost et al. from scratch.
RUN --mount=type=cache,target=/root/.cache/vcpkg \
    --mount=type=cache,target=/opt/vcpkg-downloads \
    VCPKG_HEAD="$(git -C /opt/vcpkg rev-parse HEAD)" \
    && sed -i "s/\"builtin-baseline\": \"[^\"]*\"/\"builtin-baseline\": \"${VCPKG_HEAD}\"/" /src/vcpkg.json \
    && attempt=1 \
    && until cmake -S . -B build/windows -G Ninja \
        -D CMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -D CMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -D CMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
        -D VCPKG_TARGET_TRIPLET=x64-mingw-static \
        -D VCPKG_HOST_TRIPLET=x64-linux \
        -D VCPKG_CHAINLOAD_TOOLCHAIN_FILE=/src/cmake/toolchain-mingw-w64-x86_64.cmake \
        -D BOOST_ROOT=/src/build/windows/vcpkg_installed/x64-mingw-static \
        -D BOOST_INCLUDEDIR=/src/build/windows/vcpkg_installed/x64-mingw-static/include \
        -D Boost_INCLUDE_DIR=/src/build/windows/vcpkg_installed/x64-mingw-static/include \
        -D Boost_LIBRARY_DIR_RELEASE=/src/build/windows/vcpkg_installed/x64-mingw-static/lib \
        -D Boost_LIBRARY_DIR_DEBUG=/src/build/windows/vcpkg_installed/x64-mingw-static/debug/lib \
        -D PVPGN_BUILD_V3=ON \
        -D PVPGN_BUILD_LEGACY=OFF \
        -D BUILD_TESTING=OFF \
        -D PVPGN_V3_BUILD_TESTS=OFF \
        -D PVPGN_V3_PLUGIN_TESTS=OFF \
        -D PVPGN_V3_WITH_LUA=OFF \
        -D PVPGN_V3_WARNINGS_AS_ERRORS=OFF; do \
        if [ "${attempt}" -ge "${CONFIGURE_RETRIES}" ]; then \
            exit 1; \
        fi; \
        echo "Configure attempt ${attempt} failed; clearing build tree and retrying..." >&2; \
        attempt=$((attempt + 1)); \
        rm -rf build/windows; \
    done \
    && cmake --build build/windows --config ${CMAKE_BUILD_TYPE} --parallel ${JOBS} \
    && cmake --install build/windows --config ${CMAKE_BUILD_TYPE} --prefix ${INSTALL_PREFIX}


# -----------------------------------------------------------------------------
# Stage: collect
# Gather the installed Windows executables and a manifest.
# -----------------------------------------------------------------------------
FROM build AS collect

ARG INSTALL_PREFIX=/opt/pvpgn-windows

RUN mkdir -p /export/bin /export/sbin \
    && if [ -d ${INSTALL_PREFIX}/bin ]; then cp -av ${INSTALL_PREFIX}/bin/. /export/bin/; fi \
    && if [ -d ${INSTALL_PREFIX}/sbin ]; then cp -av ${INSTALL_PREFIX}/sbin/. /export/sbin/; fi \
    && find /export -type f -name '*.exe' | sed 's#^/export/##' | sort > /export/manifest.txt


# -----------------------------------------------------------------------------
# Stage: export  (DEFAULT)
# Empty image containing the installed Windows executables. Use
# `docker buildx build --output type=local,dest=./dist/windows .` to copy the
# exported tree directly to the host filesystem.
# -----------------------------------------------------------------------------
FROM scratch AS export
COPY --from=collect /export/ /
