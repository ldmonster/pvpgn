# Build rule for target.
test_protocol_d2cs_codec: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 test_protocol_d2cs_codec
.PHONY : test_protocol_d2cs_codec

# fast build rule for target.
test_protocol_d2cs_codec/fast:
	$(MAKE) $(MAKESILENT) -f tests/unit/protocol/d2cs/CMakeFiles/test_protocol_d2cs_codec.dir/build.make tests/unit/protocol/d2cs/CMakeFiles/test_protocol_d2cs_codec.dir/build
.PHONY : test_protocol_d2cs_codec/fast

