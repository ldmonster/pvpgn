##############################################################################
# bnetd.toml  -  TOML configuration file for the main PvPGN service         #
#----------------------------------------------------------------------------#
#                                                                            #
# This is the TOML equivalent of bnetd.conf.in, used by the v3 code path.   #
# The legacy bnetd.conf is still read by the legacy (non-v3) build.         #
#                                                                            #
# Blank lines and lines beginning with "#" are ignored.                     #
# String values that contain spaces must be quoted.                         #
#                                                                            #
##############################################################################

##############################################################################
# [privileges]  — OS user/group to drop to after binding ports              #
##############################################################################

[privileges]
# Use either the name from /etc/passwd|group or a numeric id prefixed with #.
# Leave commented out to keep the current process uid/gid.
#effective_user  = "games"
#effective_group = "games"

##############################################################################
# [storage]  — Account / clan / team persistence back-end                   #
##############################################################################

[storage]
# Supported drivers: "file" (plain text) or "sql" (MySQL/PostgreSQL/SQLite).
#
# Plain-file examples:
#   path = "file:mode=plain;dir=${LOCALSTATEDIR}/users;clan=${LOCALSTATEDIR}/clans;team=${LOCALSTATEDIR}/teams;default=${SYSCONFDIR}/bnetd_default_user.plain"
#
# SQL examples:
#   path = "sql:mode=mysql;host=127.0.0.1;name=PVPGN;user=pvpgn;pass=pvpgnrocks;default=0;prefix=pvpgn_"
#   path = "sql:mode=pgsql;host=127.0.0.1;name=pvpgn;user=pvpgn;pass=pvpgnrocks;default=0;prefix=pvpgn_"
#   path = "sql:mode=sqlite3;name=${LOCALSTATEDIR}/users.db;default=0;prefix=pvpgn_"
#   path = "sql:mode=odbc;name=PVPGN;prefix=pvpgn_"
path = "file:mode=plain;dir=${LOCALSTATEDIR}/users;clan=${LOCALSTATEDIR}/clans;team=${LOCALSTATEDIR}/teams;default=${SYSCONFDIR}/bnetd_default_user.plain"

##############################################################################
# [files]  — Paths to data files and directories                            #
# Use absolute paths to avoid problems.                                     #
##############################################################################

[files]
filedir              = "${LOCALSTATEDIR}/files"
scriptdir            = "${LOCALSTATEDIR}/lua"
reportdir            = "${LOCALSTATEDIR}/reports"
chanlogdir           = "${LOCALSTATEDIR}/chanlogs"
userlogdir           = "${LOCALSTATEDIR}/userlogs"
i18ndir              = "${SYSCONFDIR}/i18n"
issuefile            = "${SYSCONFDIR}/bnissue.txt"
channelfile          = "${SYSCONFDIR}/channel.conf"
adfile               = "${SYSCONFDIR}/ad.json"
topicfile            = "${SYSCONFDIR}/topics.conf"
ipbanfile            = "${SYSCONFDIR}/bnban.conf"
mpqfile              = "${SYSCONFDIR}/autoupdate.conf"
logfile              = "${LOCALSTATEDIR}/bnetd.log"
realmfile            = "${SYSCONFDIR}/realm.conf"
maildir              = "${LOCALSTATEDIR}/bnmail"
versioncheck_file    = "${SYSCONFDIR}/versioncheck.json"
mapsfile             = "${SYSCONFDIR}/bnmaps.conf"
xplevelfile          = "${SYSCONFDIR}/bnxplevel.conf"
xpcalcfile           = "${SYSCONFDIR}/bnxpcalc.conf"
#pidfile             = "${LOCALSTATEDIR}/bnetd.pid"
ladderdir            = "${LOCALSTATEDIR}/ladders"
command_groups_file  = "${SYSCONFDIR}/command_groups.conf"
tournament_file      = "${SYSCONFDIR}/tournament.conf"
statusdir            = "${LOCALSTATEDIR}/status"
aliasfile            = "${SYSCONFDIR}/bnalias.conf"
anongame_infos_file  = "${SYSCONFDIR}/anongame_infos.conf"
DBlayoutfile         = "${SYSCONFDIR}/sql_DB_layout.conf"
supportfile          = "${SYSCONFDIR}/supportfile.conf"
transfile            = "${SYSCONFDIR}/address_translation.conf"
customicons_file     = "${SYSCONFDIR}/icons.conf"

##############################################################################
# [localization]  — Locale-aware text files                                 #
##############################################################################

[localization]
# These filenames can have translated versions in the i18ndir directory.
# (Downloadable files chathelp-war3.txt and newaccount.txt also live there.)
localizefile        = "common.xml"
motdfile            = "bnmotd.txt"
motdw3file          = "w3motd.txt"
newsfile            = "news.txt"
helpfile            = "bnhelp.conf"
tosfile             = "termsofservice.txt"

# Localize by game language (false) or by user country (true)?
localize_by_country = true

##############################################################################
# [log]  — Event logging                                                    #
##############################################################################

[log]
# Multiple levels separated by commas.
# Available: none, trace, debug, info, warn, error, fatal
levels = "fatal,error,warn,info,debug,trace"
#levels = "fatal,error,warn,info"

##############################################################################
# [d2cs]  — Diablo II Character Server integration                          #
##############################################################################

[d2cs]
# Version of D2CS server to connect with (0 = disable version check).
version         = 0
# Allow the D2CS server to change realm names?
allow_setname   = true

##############################################################################
# [downloads]  — Icon files reported to clients                             #
# Paths are relative to [files].filedir.                                    #
##############################################################################

[downloads]
iconfile      = "icons.bni"
war3_iconfile = "icons-WAR3.bni"
star_iconfile = "icons_STAR.bni"

##############################################################################
# [client_verification]  — Which clients may connect                        #
##############################################################################

[client_verification]
# Comma-separated list of allowed client tags, or "all".
# Valid tags: all, chat, dshr, drtl, sshr, star, sexp, w2bn, d2dv, d2xp,
#             war3, w3xp, tsun, tsxp, ralt, ral2, dn2k, noxx, noxq, rngd,
#             rfds, yuri, ebfd
# Example: allowed_clients = "war3,w3xp"
allowed_clients       = "all"

# Allow clients that fail the checksum test?
allow_bad_version     = true

# Allow clients not listed in the versioncheck file?
allow_unknown_version = true

##############################################################################
# [timing]  — Periodic timers and delays (all values in seconds)            #
##############################################################################

[timing]
# Interval between account file flushes (0 = never flush automatically).
usersync             = 300
# Seconds of inactivity before an account is unloaded from memory.
userflush            = 3600
# Number of accounts checked per flush cycle.
userstep             = 100
# Flush accounts for connected users too?
userflush_connected  = true

# How often to send latency-test packets to clients.
latency              = 600
# How often to send null/keepalive packets.
nullmsg              = 120

# Graceful-shutdown delay.
shutdown_delay       = 300
# Amount the shutdown countdown is decremented per SIGTERM/SIGINT.
shutdown_decr        = 60

# How often to check IP bans for expiration.
ipban_check_int      = 30

##############################################################################
# [policy]  — Server behaviour and flood-control                            #
##############################################################################

[policy]
# Allow new account creation?
new_accounts             = true
# Maximum accounts (0 = unlimited).
max_accounts             = 0
# Kick the old session when the same account logs in again?
kick_old_login           = true
# Prompt before creating a new channel?
ask_new_channel          = true
# Write a game report for every game (not just ladder games)?
report_all_games         = true
# Write reports for Diablo I/II games?
report_diablo_games      = false
# Hide password-protected games from the game list?
hide_pass_games          = true
# Hide already-started games from the game list?
hide_started_games       = true
# Hide non-permanent channels from the channel list?
hide_temp_channels       = true
# Count all disconnects as losses?
disc_is_loss             = false
# Additional game types counted as ladder (topvbot, melee, ffa, oneonone).
ladder_games             = "none"
# Game-name prefix required for ladder counting (empty = all matching types).
ladder_prefix            = ""
# Allow all users to use /con and /connections?
enable_conn_all          = true
# Hide client IP addresses from non-admins?
hide_addr                = false
# Log private channel messages to chanlogdir?
chanlog                  = false

# Mail
mail_support             = true
mail_quota               = 5

# Brute-force password-fail banning (0 = disabled).
passfail_count           = 0
passfail_bantime         = 300  # seconds

# Maximum users per private channel (0 = unlimited).
maxusers_per_channel     = 0

##############################################################################
# [account]  — Account storage and lookup                                   #
##############################################################################

[account]
# Name account files by player name (true) or account number (false)?
savebyname               = true
# Flush account data on logoff?
sync_on_logoff           = false
# Hash-table size for account lookup (larger = faster for many accounts).
hashtable_size           = 61
# Extra symbols allowed in account names beyond alphanumerics.
# WARNING: '/', '\' are always filtered; '*', '?' can cause problems.
account_allowed_symbols  = "-_[]"
# Force displayed username to match the registered account name?
account_force_username   = false
# Maximum friends per user.
max_friends              = 20

##############################################################################
# [tracking]  — PvPGN tracker registration                                  #
##############################################################################

[tracking]
# Interval in seconds between tracker packets (0 = disabled).
track         = 60
# Comma-delimited list of tracker hostnames (with optional :port).
trackaddrs    = "track.pvpgn.pro,track.pvpgn.org,bntrack.darkwings.org,bnet.mivabe.nl,track.eurobattle.net"
location      = "unknown"
description   = "unknown"
url           = "https://github.com/pvpgn/pvpgn-server"
contact_name  = "a PvPGN user"
contact_email = "unknown"

##############################################################################
# [network]  — TCP/UDP listener addresses and connection limits             #
##############################################################################

[network]
# Server name reported to clients.
servername           = "PvPGN Realm"
# Maximum concurrent connections (minimum 32).
max_connections      = 1000
# Maximum packets in a client's outbound queue (0 = unlimited).
packet_limit         = 1000
# v3 strangler-fig mode: 0 = legacy fdwatch, 1 = v3 TcpSession pipeline.
v3_tcp_session_mode  = 0
# Maximum concurrent logged-in users (0 = unlimited).
max_concurrent_logins = 0
# Enable TCP keepalive on client sockets?
use_keepalive        = false
# Maximum connections per source IP (0 = unlimited; D2CS exempt).
max_conns_per_IP     = 0
# Comma-delimited listen addresses for Battle.net protocol.
# Format: "host:port" — empty host = all interfaces; empty port = 6112.
servaddrs            = ":"
# UDP test port (0 = use the TCP source port).
#udptest_port        = 6112
# W3 Play-Game router address.
w3routeaddr          = "0.0.0.0:6200"
# Timeout (seconds) before killing stale init/defer connections.
initkill_timer       = 120

##############################################################################
# [wol]  — Westwood Online (WOL) configuration  [experimental]             #
##############################################################################

[wol]
# Listen addresses for WOL connections (blank = disabled).
# WOLv1 default port: 4000; WOLv2 default port: 4005.
# DO NOT change the ports — WOL clients hard-code them.
#wolv1addrs    = ":4000"
#wolv2addrs    = ":4005"
#wgameresaddrs = ":4807"
#apiregaddrs   = ":5400"

timezone  = "-8"
longitude = "36.1083"
latitude  = "-115.0582"

# WOL auto-update FTP server credentials.
autoupdate_serverhost = "westwood-patch.ea.com"
autoupdate_username   = "update"
autoupdate_password   = "world96"

##############################################################################
# [irc]  — Internet Relay Chat (IRC) configuration  [experimental]         #
##############################################################################

[irc]
# Listen address for IRC connections (blank = disabled; default port 6667).
#addrs        = ":6667"
# IRC network name.
network_name  = "PvPGN"
# Hostname reported to IRC clients (empty = auto-detect).
#hostname     = "none"
# IRC connection timeout in seconds.
latency       = 180

##############################################################################
# [telnet]  — Telnet configuration                                          #
##############################################################################

[telnet]
# Listen address for telnet connections (blank = disabled; default port 23).
#addrs = ":23"

##############################################################################
# [ladder]  — Warcraft III ladder text/XML output                           #
##############################################################################

[ladder]
# Interval in seconds between ladder file updates (0 = disabled).
war3_update_secs  = 300
# Write ladder output as XML instead of plain text?
xml_output        = false

##############################################################################
# [status]  — Server status file output                                     #
##############################################################################

[status]
# Interval in seconds between status file updates (0 = disabled).
update_secs   = 60
# Write status output as XML?
xml_output    = false

##############################################################################
# [clan]  — Clan settings                                                   #
##############################################################################

[clan]
# Hours a new member remains a "newer" (Peon icon, cannot be promoted).
# 0 = no waiting period.  Default: 168 (7 days).
newer_time              = 0
# Maximum members per clan (10–100).
max_members             = 50
# Default channel privacy when a clan is created (1 = private, 0 = public).
channel_default_private = 0
# Minimum accepted invitations required to create a clan (0 = no minimum).
min_invites             = 2

##############################################################################
# [messages]  -- Chat quota / flood control                                 #
##############################################################################

[messages]
# Master toggle for chat flood-control quota.
quota                    = true
# Maximum lines a user may send within `quota_time` seconds (1-100).
quota_lines              = 5
# Window in seconds for the line quota (1-60).
quota_time               = 5
# Virtual wrap column (1-256). Lines wider than this count as multiple.
quota_wrapline           = 40
# Hard line-length limit (1-256). Longer lines are rejected.
quota_maxline            = 200
# Lines beyond `quota_lines` before disconnect (1-100).
quota_dobae              = 7

##############################################################################
# [command_log]  -- User command logging                                    #
##############################################################################

[command_log]
# Log user commands to files in userlogdir?
log_commands       = true
# Log commands issued by users in these command groups (global ops/admins
# are always included).
log_command_groups = "2345678"
# Comma-separated list of commands to log (empty = log all commands).
log_command_list   = ""
# Notice broadcast on channels with command-logging enabled.
log_notice         = "*** Please note this channel is logged! ***"
