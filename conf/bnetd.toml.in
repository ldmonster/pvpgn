code = "DRTL"

# --- Diablo: Retail icon set ---
# Use Bni Icon Builder to edit icons.bni
# https://github.com/pvpgn/bni-icon-builder

[icons.sets.DRTL.vars]
class        = 'Record\DRTL\0\class'
level        = 'Record\DRTL\0\level'
dexterity    = 'Record\DRTL\0\dexterity'
magic        = 'Record\DRTL\0\magic'
vitality     = 'Record\DRTL\0\vitality'
strength     = 'Record\DRTL\0\strength'
gold         = 'Record\DRTL\0\gold'
diablo_kills = 'Record\DRTL\0\diablo kills'
username     = 'BNET\acct\username'

[[icons.sets.DRTL.icons]]
key = 0
rank = "warrior"
code = "DRTL"
[[icons.sets.DRTL.icons]]
key = 1
rank = "rogue"
code = "DRTL"
[[icons.sets.DRTL.icons]]
key = 2
rank = "sorcerer"
code = "DRTL"

[icons.sets.DRTL.stats]
template = """
{{username}}'s record:
level: {{level}}
class: {{class->rank}}
stats: {{strength}} str / {{magic}} mag / {{dexterity}} dex / {{vitality}} vit / {{gold}} gold
Diablo kills: {{diablo_kills}}
"""

[[icons.sets.DRTL.iconstash]]
alias = "demon"
code = "EYES"

# =============================================================================
# [[realms]] — Inlined from conf/realm.conf.in (Plan 03)
# =============================================================================
#
# List of Diablo II Realms. Realms are areas that hold closed characters and
# games. Users are given this list of realms to choose from when creating a
# new character. Next time the character is used, they will automatically join
# the same realm.
#
# The realm server runs on port 6113 by default.
#
# WARNING: DO NOT USE "127.0.0.1" or "localhost" FOR ANY IP ADDRESS
#
# Example (having a d2cs server running on IP 1.2.3.4):
#   [[realms]]
#   name        = "D2CS"
#   description = "PvPGN Closed Realm"
#   address     = "1.2.3.4:6113"

# No realms defined by default. Add [[realms]] entries above as needed.
