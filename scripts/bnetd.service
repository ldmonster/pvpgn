[Unit]
Description=PvPGN Battle.net Emulation Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bnetd -c /etc/pvpgn/bnetd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
User=pvpgn
Group=pvpgn
WorkingDirectory=/var/lib/pvpgn

[Install]
WantedBy=multi-user.target
