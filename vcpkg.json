{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "pvpgn",
  "version": "0.1.0",
  "description": "Player vs Player Gaming Network -- Battle.net realm server",
  "builtin-baseline": "7476f0d4e77d3333fbb249657df8251c28c4faae",
  "dependencies": [
    {
      "name": "zlib",
      "platform": "windows"
    },
    "fmt",
    "libsodium",
    "nlohmann-json",
    "boost-system",
    "boost-asio",
    "boost-fiber",
    "boost-context",
    "boost-circular-buffer",
    "boost-intrusive",
    "boost-lockfree",
    {
      "name": "catch2",
      "version>=": "3.5.4"
    }
  ],
  "features": {
    "lua": {
      "description": "Enable Lua scripting support",
      "dependencies": [ "lua" ]
    },
    "sqlite": {
      "description": "Enable SQLite3 storage backend",
      "dependencies": [ "sqlite3" ]
    },
    "mysql": {
      "description": "Enable MySQL storage backend",
      "dependencies": [ "libmysql" ]
    }
  }
}
